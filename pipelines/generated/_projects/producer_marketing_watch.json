{
  "name": "Insurance Producer Marketing Watch",
  "client": "Producer Marketing Watch",
  "cadence": "month",
  "anchor": "rolling",
  "window_field": "added_to_database",
  "home_states": "Washington, Oregon, California",
  "deck": {
    "enabled": true,
    "title": "{client} \u2014 {period}",
    "filename": "Producer_Marketing_{month_year}.pptx",
    "title_slide": true,
    "summary_slide": true,
    "section_headings": true,
    "closing_slide": true
  },
  "workbook": {
    "enabled": true,
    "filename": "Producer_Marketing_{mmddyy}.xlsx"
  },
  "email": {
    "enabled": false,
    "env_var": "RS_EMAIL_TO"
  },
  "notes": "Two deliberate variations from the other examples: the audience is Insurance Producer/Financial Advisor rather than Consumer, and the window is bounded by added_to_database on a rolling 30 days. Compare the row counts against the same sections bounded by the mailed date \u2014 they should differ, and that difference is the point of the setting.",
  "sections": [
    {
      "id": "ffdea1ef",
      "title": "Agent Recruiting",
      "heading": "Growing the field force",
      "search": {
        "companies": "",
        "sectors": [
          "Insurance"
        ],
        "channels": [
          "Email",
          "Direct Mail",
          "Website/URL"
        ],
        "keyword": "\"appointment\" or \"contract with us\" or \"join our\" or \"become an agent\" or \"producer\"",
        "audience": "Insurance Producer/Financial Advisor",
        "limit": 200,
        "only_credit_unions": false,
        "company_must_match": "",
        "company_must_not_match": "",
        "subcategory_must_include": "",
        "subcategory_must_exclude": "",
        "collapse_repeats": true,
        "max_per_creative": 2
      },
      "sheet": {
        "enabled": true,
        "tab": "Recruiting",
        "columns": [
          "EntryID",
          "Primary Company",
          "Headline",
          "Media Channel",
          "Quarter",
          "Product",
          "PDF Content",
          "Additional Companies",
          "Primary Sector",
          "Primary Category",
          "Primary Sub Category",
          "Mailing Type"
        ]
      },
      "feature": {
        "enabled": true,
        "count": 4,
        "how_to_choose": "Carriers recruiting or appointing producers. Prefer pieces naming a concrete incentive: a bonus, a lead programme, or faster underwriting.",
        "what_to_say": "One paragraph naming each carrier and what it is dangling in front of producers.",
        "callout_limit": 374,
        "one_per_company": true,
        "never_reuse": true
      }
    },
    {
