        "companies": "Chase\nAmerican Express\nCitibank\nCapital One\nDiscover\nBank of America\nWells Fargo",
        "sectors": [
          "Credit Cards"
        ],
        "channels": [
          "Email",
          "Direct Mail",
          "Social Media",
          "Online Display"
        ],
        "keyword": "\"travel\" or \"miles\" or \"airline\" or \"hotel\" or \"lounge\"",
        "audience": "Consumer",
        "limit": 200,
        "only_credit_unions": false,
        "company_must_match": "",
        "company_must_not_match": "",
        "subcategory_must_include": "",
        "subcategory_must_exclude": "",
