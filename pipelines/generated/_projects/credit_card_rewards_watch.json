        "how_to_choose": "Cards sold on travel value: transferable points, airline or hotel co-brands, lounge access. Prefer pieces stating a sign-up bonus.",
        "what_to_say": "One paragraph naming each issuer, the card, and the bonus offered.",
        "callout_limit": 374,
        "one_per_company": true,
        "never_reuse": true
